{
  "listen_addr": "127.0.0.1:8765",
  "bearer_token": "REPLACE_WITH_SECURE_RANDOM_TOKEN",
  "screenshot_width": 720,
  "screenshot_jpeg_quality": 70,
  "guard_packages": [
    "com.tencent.tmgp.sgame"
  ],
  "guard_poll_interval_ms": 2000,
  "guard_resume_grace_ms": 3000,
  "cdp_socket": "chrome_devtools_remote",
  "sys_socket": "agent_sys",
  "clip_helper_path": "/data/local/tmp/.ag_cache/helper.jar",
  "pause_flag_path": "/data/adb/android_agent/paused",
  "shell_timeout_ms": 10000,
  "memory_dir": "/data/adb/android_agent/memory",
  "llm": {
    "provider": "openai",
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "max_steps": 80,
    "timeout_sec": 60
  },
  "schedule": {
    "enabled": false,
    "entries": [
      {
        "id": "daily-all",
        "job": "daily_all",
        "enabled": true,
        "window_start": "08:15",
        "window_end": "09:30",
        "defer_on_game": true
      }
    ]
  }
}
